{
  "name": "playground",
  "version": "1.0.0",
  "private": true,
  "description": "A React and TypeScript Playground app with a public Supabase Edge Function demo.",
  "scripts": {
    "dev": "pnpm quran:data --notices-only && pnpm lane:data --notices-only && pnpm mufradat:data --notices-only && vite",
    "build": "pnpm quran:data --notices-only --require-publication && pnpm lane:data --notices-only && pnpm mufradat:data --notices-only && tsc -b && vite build --configLoader runner",
    "build:preview": "pnpm quran:data --notices-only && pnpm lane:data --notices-only && pnpm mufradat:data --notices-only && tsc -b && vite build --configLoader runner",
    "quran:data": "node scripts/quran-data/import.mjs",
    "quran:backend": "node scripts/quran-data/package.mjs",
    "lane:data": "python3 scripts/lane-data/import.py --expanded",
    "mufradat:data": "python3 scripts/mufradat-data/import.py --expanded",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "10.6.5",
    "@axe-core/playwright": "4.14.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "4.6.7",
    "@scratch-pages/ui": "workspace:*",
    "@scratch-pages/design-tokens": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@scratch-pages/api-contracts": "workspace:*"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
